# Required — bot will not start without these
RPC_URL=https://api.mainnet-beta.solana.com
KEYPAIR_PATH=/path/to/.solana_trader.key
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Gas reserve (lamports); default 0.05 SOL
GAS_RESERVE_LAMPORTS=50000000

# SMTP (optional — alerts only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Paper mode by default; flip in the panel or via --live flag
DEFAULT_MODE=paper
